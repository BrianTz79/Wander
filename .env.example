# ─────────────────────────────────────────────────────────────────────
#  Wander — variables de entorno
#  Copiar a `.env` y rellenar. `.env` NUNCA se commitea (ver .gitignore).
#
#  Para generar los secretos criptográficos:
#    openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────
POSTGRES_USER=wander
POSTGRES_PASSWORD=cambiame_por_una_contrasena_larga_y_aleatoria
POSTGRES_DB=wander
# El host `db` es el nombre del servicio en docker-compose.
DATABASE_URL=postgresql://wander:cambiame_por_una_contrasena_larga_y_aleatoria@db:5432/wander?schema=public

# ── Secretos de sesión y cifrado ─────────────────────────────────────
# Los tres DEBEN ser distintos entre sí y de al menos 32 bytes en hex.
# Si falta cualquiera, el backend se niega a arrancar (config/env.ts).
JWT_SECRET=
REFRESH_SECRET=
# Clave AES-256-GCM para cifrar los tokens OAuth en reposo.
# Debe ser exactamente 64 caracteres hex (32 bytes).
ENCRYPTION_KEY=

# ── URL pública ──────────────────────────────────────────────────────
# Se usa para los callbacks de OAuth, los enlaces de correo y el CORS.
PUBLIC_URL=https://wander.ourocore.net
# En desarrollo local: http://localhost:3045

# ── Steam ────────────────────────────────────────────────────────────
# Obtener en: https://steamcommunity.com/dev/apikey
# El feed público XML funciona sin key; esta habilita horas de toda la
# biblioteca, logros y badges.
STEAM_API_KEY=

# ── Discord (OAuth para login + vinculación) ─────────────────────────
# Crear app en: https://discord.com/developers/applications
# Redirect URI: ${PUBLIC_URL}/api/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Google (OAuth) ───────────────────────────────────────────────────
# Crear credenciales en: https://console.cloud.google.com/apis/credentials
# Redirect URI: ${PUBLIC_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Spotify (opcional — también funciona vía Lanyard si hay Discord) ──
# Crear app en: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Twitch (opcional) ────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── GIFs (opcional — selector de GIFs en el chat) ────────────────────
# https://developers.giphy.com/
GIPHY_API_KEY=

# ── Túnel de Cloudflare ──────────────────────────────────────────────
# Obtenerlo en: Cloudflare Zero Trust → Networks → Tunnels → wander →
# Configure → copiar el token del comando de instalación.
# Public Hostname: wander.ourocore.net → HTTP → frontend:80
TUNNEL_TOKEN=

# ── Puertos del host ─────────────────────────────────────────────────
# 3045 está libre (verificado). Solo se usa para pruebas locales;
# en producción el tráfico entra por el túnel.
PORT_FRONTEND=3045
